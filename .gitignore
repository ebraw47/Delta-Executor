# Installer binaries (often >100MB — keep locally / on host, not in git)
/public/downloads/*.apk
/public/downloads/*.ipa
/public/downloads/*.exe
/public/downloads/*.dmg
/public/downloads/*.zip
/public/downloads/*.msi
